# Database (Neon PostgreSQL recommended for Vercel)
DATABASE_URL="postgresql://user:password@host:5432/lumiere_db?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/lumiere_db?schema=public"

# Auth
JWT_SECRET="ganti-dengan-random-string-panjang-minimal-32-karakter"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Site URL (untuk reset password email)
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# SMTP Email (opsional, untuk kirim email reset password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="\"Lumière Furniture\" <no-reply@lumiere.com>"
